  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@inquirer/prompts": "^8.3.0",
    "@opencode-ai/sdk": "^1.2.15",
    "@openai/codex-sdk": "^0.106.0",
    "grammy": "^1.40.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "typescript": "^5.0.0"
  }
