{
  "name": "@4via6/relay",
  "version": "1.2.1",
  "description": "Telegram bot for AI coding agents — supports OpenCode, Claude Code, and OpenAI Codex",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "relay": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
